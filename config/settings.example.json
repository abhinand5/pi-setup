{
  "lastChangelogVersion": "1.5.0",
  "theme": "catppuccin-mocha",
  "compaction": {
    "enabled": true
  },
  "packages": [
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-markdown-preview",
    "npm:pi-mcp-adapter",
    {
      "source": "npm:context-mode",
      "extensions": [
        "-build/adapters/pi/extension.js"
      ],
      "skills": [
        "-skills/context-mode/SKILL.md",
        "-skills/ctx-doctor/SKILL.md",
        "-skills/ctx-index/SKILL.md",
        "-skills/ctx-insight/SKILL.md",
        "-skills/ctx-purge/SKILL.md",
        "-skills/ctx-search/SKILL.md",
        "-skills/ctx-stats/SKILL.md",
        "-skills/ctx-upgrade/SKILL.md"
      ]
    },
    "npm:@narumitw/pi-goal",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@dustydonkey/pi-spinner",
    "npm:@juicesharp/rpiv-btw",
    "npm:@ff-labs/pi-fff",
    "npm:pi-subagents",
    "https://github.com/amosblomqvist/pi-observational-memory",
    "npm:@senad-d/micme",
    "npm:pi-pstack-adapter"
  ],
  "defaultProvider": "openrouter",
  "defaultModel": "deepseek/deepseek-v4.1-flash-1017",
  "defaultThinkingLevel": "high",
  "httpProxy": "http://127.0.0.1:10808",
  "hideThinkingBlock": true,
  "skills": [
    "+skills/find-skills/SKILL.md",
    "-skills/safety-guard"
  ],
  "defaultProjectTrust": "always",
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-mcp-adapter\",\"scope\":\"user\"}": "7.0.1",
    "{\"source\":\"npm:@narumitw/pi-goal\",\"scope\":\"user\"}": "0.54.15",
    "{\"source\":\"npm:@dustydonkey/pi-spinner\",\"scope\":\"user\"}": "1.0.2",
    "{\"source\":\"npm:pi-subagents\",\"scope\":\"user\"}": "0.87.0",
    "{\"source\":\"npm:@senad-d/micme\",\"scope\":\"user\"}": "0.3.8",
    "{\"source\":\"npm:pi-pstack-adapter\",\"scope\":\"user\"}": "0.10.0"
  },
  "extensions": [
    "-builtin:mcp",
    "-extensions/safety-guard.ts"
  ],
  "defaultTools": [
    "+codemode"
  ],
  "subagents": {
    "defaultModel": "openrouter/z-ai/glm-5.3-flash",
    "modelScope": {
      "enforce": true,
      "strict": false,
      "allow": [
        "openrouter/deepseek/deepseek-v4-flash-vision-exp",
        "openrouter/deepseek/deepseek-v4.1-flash",
        "openrouter/deepseek/deepseek-v4.1-flash-1017",
        "openrouter/z-ai/glm-4.7-flash",
        "openrouter/z-ai/glm-5",
        "openrouter/z-ai/glm-5.1",
        "openrouter/z-ai/glm-5.2",
        "openrouter/z-ai/glm-5.3",
        "openrouter/z-ai/glm-5.3-flash",
        "openrouter/inclusionai/ling-3.0-flash",
        "openrouter/inclusionai/ling-3.0-flash-vl",
        "openrouter/inclusionai/ling-3.1-flash",
        "openrouter/minimax/minimax-m3",
        "openrouter/minimax/minimax-m3.1-flash"
      ],
      "agents": {
        "reviewer": {
          "allow": [
            "openrouter/z-ai/glm-5.3-flash",
            "openrouter/deepseek/deepseek-v4.1-flash-1017",
            "openrouter/z-ai/glm-5.3"
          ]
        },
        "oracle": {
          "allow": [
            "openrouter/z-ai/glm-5.3-flash",
            "openrouter/deepseek/deepseek-v4.1-flash-1017",
            "openrouter/z-ai/glm-5.3"
          ]
        },
        "evidence-auditor": {
          "allow": [
            "openrouter/deepseek/deepseek-v4.1-flash-1017",
            "openrouter/z-ai/glm-5.3-flash",
            "openrouter/z-ai/glm-5.3"
          ]
        }
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "openrouter/z-ai/glm-5.3-flash",
        "thinking": "low"
      },
      "worker": {
        "model": "openrouter/z-ai/glm-5.3-flash",
        "thinking": "medium"
      },
      "researcher": {
        "thinking": "low",
        "model": "openrouter/z-ai/glm-5.3-flash"
      },
      "delegate": {
        "model": "openrouter/z-ai/glm-5.3-flash"
      },
      "reviewer": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
        "thinking": "medium"
      },
      "oracle": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
        "thinking": "medium"
      },
      "evidence-auditor": {
        "model": "openrouter/deepseek/deepseek-v4.1-flash-1017",
        "thinking": "medium"
      },
      "uat-browser": {
        "model": "openrouter/z-ai/glm-5.3-flash",
        "thinking": "high"
      }
    }
  },
  "showCacheMissNotices": true,
  "observational-memory": {
    "models": {
      "observer": {
        "provider": "openrouter",
        "id": "deepseek/deepseek-v4.1-flash-1017",
        "thinking": "low"
      },
      "consolidator": {
        "provider": "openrouter",
        "id": "deepseek/deepseek-v4.1-flash-1017",
        "thinking": "medium"
      }
    }
  }
}
