# UAT_AUTH_DIR.
**/uat-auth/

# Pi runtime state
sessions/
npm/
git/
mcp-cache.json
mcp-npx-cache.json
mcp-onboarding.json
local-models.json

# Local generated backups
*.backup
*.bak
themes.backup-*/

# Serena AI tool state
.serena/

# Playwright MCP artifacts and optional persistent browser profile
.playwright-mcp/
playwright-profile/

# Node / editor noise
node_modules/
.DS_Store
.vscode/
.idea/
*.log
