# Secrets / credentials
auth.json
*.key
*.pem
.env
.env.*
# Saved browser logins (written by a project login command) live in ~/.pi/agent/uat-auth, outside the
# repo on purpose; this line is a belt-and-braces guard for a redirected
# UAT_AUTH_DIR.
**/uat-auth/

# Pi runtime state
sessions/
npm/
git/
mcp-cache.json
mcp-npx-cache.json
mcp-onboarding.json
local-models.json

# Python bytecode cache (ручной `py_compile bin/ru-spellcheck` кладёт bin/__pycache__)
__pycache__/
*.pyc

# Local generated backups
*.backup
*.bak
themes.backup-*/

# Serena AI tool state
.serena/

# Playwright MCP artifacts and optional persistent browser profile
.playwright-mcp/
playwright-profile/

# Node / editor noise
node_modules/
.DS_Store
.vscode/
.idea/
*.log
