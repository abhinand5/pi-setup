#!/usr/bin/env python3
"""ru-spellcheck — deterministic Russian prose checker (homoglyphs + hunspell ru_RU).

Catches the failure class seen on 2026-11-16 in msb-lk sessions:
  * Latin homoglyphs / accented Latin inside Cyrillic words: лоkalной, восстанóвленное, обéих, мoлча
  * unstressed-vowel corruption: нузен, открито, которий, стот, деньгы, напровление

Usage:
  ru-spellcheck FILE...           check files (Markdown/Textile/plain)
  cmd | ru-spellcheck -           check stdin
  ru-spellcheck --homoglyph-only F   only the hard error class (exit 1 on hit); an input longer
                                     than 40 lines / 500 tokens exits 3 — see "Gate" below
  ru-spellcheck --allow-long F    keep --homoglyph-only on a long input (deliberate bypass)
  ru-spellcheck --added BASE FILE проверять только строки, добавленные относительно BASE
                                     (git diff -U0 BASE -- FILE); номера строк остаются файловыми,
                                     чужие находки в файле не мешают
  ru-spellcheck --add СЛОВО       add a known-good word to the project's allowlist
  ru-spellcheck --add-personal СЛОВО  add it to the personal allowlist instead
  ru-spellcheck --json FILE...    machine-readable

Allowlists, applied on top of hunspell:
  * personal: $XDG_CONFIG_HOME/ru-spellcheck/allow.txt (machine-wide, travels with the agent);
  * project:  .ru-spellcheck-allow at the repository root, one word per line. Project jargon
    belongs there, not in the personal file: the file is committed with the code, so every
    agent and the CI see the same vocabulary. Files are searched upwards from the checked
    file (or the cwd for stdin) up to the git root; the personal file still applies.

Denylist — the opposite list, and it wins over both allowlists and over hunspell:
  * personal: $XDG_CONFIG_HOME/ru-spellcheck/deny.txt (seeded and overwritten from the repo);
  * project:  .ru-spellcheck-deny at the repository root.
A word from the denylist is always a finding (kind DENY), even if it is spelled correctly or sits
in an allowlist: it is vocabulary the agent invented and must not legitimize (воркtree, инлайн,
харнесс). Those entries are human-owned policy — `--add` refuses to write a denylisted word, and
the deny file is not something an agent edits to legalize its own wording. Matching is exact on
the word form (no stem expansion: `сет` must not ban `сети`), unless the entry ends with `*`:
`ассерт*` covers `ассерты`/`ассертов`, because the short forms are the ones that leak into SPELLING
with a false suggestion (#15836 п.3). An entry may be Latin (`tip`): it is matched on the segments
of any script, because a pure-Latin token never reaches the dictionary pass and would otherwise be
banned on paper only. The denylist is not consulted by
`--homoglyph-only`: that gate is about scripts, and mixed-script deny entries are caught there as
HOMOGLYPH anyway.

Gate: `--homoglyph-only` is the gate for short prose (a chat message, a Redmine note): zero false
positives, exit 1 on a hit. A commit body is usually longer than 40 lines, so it takes the full
check (or `--allow-long`) instead: `ru-spellcheck - < /tmp/msg.txt`. It sees only script mixing, so a long document —
a hand-off note, a README, a task description — passes it while losing its vowels (сесии,
велечину, скрыпт), and that class needs the dictionary. A long input is therefore refused with
exit 3 and a hint to run the full check, rather than reported clean (#15799 п.2). The threshold
is 40 lines or 500 tokens, whichever comes first, counted over all inputs together — a token is
what the checker splits on (whitespace and punctuation, code and paths included), so the count runs
ahead of `wc -w` on prose with dashes and commas; `--allow-long` bypasses it on purpose. The refusal is checked
before any output, so `--json --homoglyph-only` on a long input also gives exit 3 and an empty
stdout rather than a partial report.

Exit: 0 clean, 1 findings, 2 usage/dictionary problem, 3 --homoglyph-only on a long input.
Masked as non-prose: fenced code, `inline code`, URLs, HTML tags, paths, versions,
Latin tokens, and hyphen compounds whose parts are each pure-script (Redmine-задачи).
"""
import json
import os
import re
import sys

CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
ALLOW = os.path.join(CONFIG_HOME, "ru-spellcheck", "allow.txt")
DENY = os.path.join(CONFIG_HOME, "ru-spellcheck", "deny.txt")
REPO_ALLOW_NAME = ".ru-spellcheck-allow"
REPO_DENY_NAME = ".ru-spellcheck-deny"
BASELINE = os.path.join(CONFIG_HOME, "ru-spellcheck", "baseline.txt")
# Short-prose threshold for --homoglyph-only: past it the gate cannot see the error class it is
# asked to catch, so it refuses the input instead of reporting it clean (#15799 п.2).
MAX_SHORT_LINES = 40
MAX_SHORT_WORDS = 500
WORD = re.compile(r"[А-Яа-яЁё][А-Яа-яЁё-]+")

MASK_PATTERNS = [
    # Escape-последовательности — не буквы (#15740 п.1): в рецепте Makefile `printf '…%s\nветка'`
    # литеральный `\n` стоит перед кириллицей, и без маски латинская `n` приклеивалась к слову:
    # гейт "без ложных срабатываний" валил корректный код, и рецепт подстраивали под проверку.
    re.compile(r"\\(?:[nrtvfbae'\"\\/]|x[0-9A-Fa-f]{2}|[0-7]{1,3})"),
    re.compile(r"```.*?```", re.S),
    re.compile(r"`[^`\n]*`"),
    re.compile(r"https?://\S+"),
    re.compile(r"<[^>\n]{1,80}>"),
    # Textile-код: `@слово@` — каждая заметка в Redmine пишется им, и термин в коде — цитата,
    # а не проза. Без маски полный прогон даёт находки на цитатах (#15836 п.8).
    # Границы — негробельные: `[^@\n]+` маскировал бы прозу между двумя упоминаниями
    # (`@ivan скрыпт готов @petr`), и полный прогон молча отдавал бы 0 на непроверенном тексте.
    re.compile(r"@\S(?:[^@\n]*\S)?@"),
    re.compile(r"(?<![\w])(?:~|\.{0,2})?/[\w./-]+"),  # absolute/relative paths
    re.compile(r"(?<![\w])[\w-]+(?:\.[\w-]+)+/[\w./-]+"),  # dir/file.ext, owner/repo.git
    re.compile(r"(?<![\w])[\w.-]*\.[A-Za-z]{1,5}\b"),  # bare filename: лизинга.md, X.php
    re.compile(r"\b[\w-]+@[\w.-]+\b"),
    re.compile(r"\bv?\d+(?:\.\d+)+[\w-]*\b"),
    re.compile(r"\b[0-9a-f]{7,40}\b"),
]

TOKEN = re.compile(r"[^\s()\[\]{}<>«»„“”\"'`|,;:!?…—–+=→·/\\’@%$#№]+")
EDGE = "*_~"  # markdown emphasis clinging to a word: **Что, задачи.**
ABBREV = re.compile(r"[А-Яа-яЁё]{1,3}\.(?:[А-Яа-яЁё]{1,3}\.)*[А-Яа-яЁё]{0,3}\.?")
CYR = re.compile(r"[А-Яа-яЁё]")
LAT = re.compile(r"[A-Za-z]")
# Latin letters carrying diacritics: the signature of "восстанóвленное", "обéих".
DIACRITIC_LATIN = re.compile(r"[\u00c0-\u024f\u1e00-\u1eff]")
SCRIPT_MIX = re.compile(r"[А-Яа-яЁё].*[A-Za-z\u00c0-\u024f]|[A-Za-z\u00c0-\u024f].*[А-Яа-яЁё]")

DICT_NAMES = ("ru_RU", "ru", "ru_RU.UTF-8")


SYSTEM_PY = "/usr/bin/python3"


def need_enchant():
    """Import enchant, or re-exec under the system interpreter when a project venv shadows python3."""
    try:
        import enchant  # noqa: F401
        return
    except ImportError:
        pass
    in_venv = sys.prefix != sys.base_prefix  # venv/bin/python3 is a symlink: compare prefixes
    if (os.environ.get("RU_SPELLCHECK_REEXEC") != "1" and os.path.exists(SYSTEM_PY)
            and (in_venv or os.path.realpath(sys.executable) != os.path.realpath(SYSTEM_PY))):
        os.environ["RU_SPELLCHECK_REEXEC"] = "1"
        os.execv(SYSTEM_PY, [SYSTEM_PY, os.path.abspath(__file__)] + sys.argv[1:])
    # Код 2, а не 1: 1 — это находки (штатный красный), а тесты и гейты трактуют 2 как
    # «среда не готова → SKIP» (#15742 п.2). Со строкой в sys.exit код был бы 1 и тест
    # без enchant падал бы вместо пропуска.
    print("ru-spellcheck: python3-enchant not installed (venv python3 shadowed the system one; "
          f"try {SYSTEM_PY})", file=sys.stderr)
    sys.exit(2)


def load_dict():
    need_enchant()
    import enchant
    for name in DICT_NAMES:
        try:
            d = enchant.Dict(name)
            if d.tag:
                return d
        except Exception:
            continue
    print("ru-spellcheck: no Russian hunspell dictionary (apt install hunspell-ru)", file=sys.stderr)
    sys.exit(2)


def stem(w):
    """Crude Russian stem, only for baseline comparison: скиллу/скиллы/скиллов -> скилл."""
    w = w.lower()
    for cut in (4, 3, 2, 1):
        if len(w) - cut >= 4:
            yield w[:-cut]
    yield w


def load_baseline(path):
    if not path or not os.path.exists(path):
        return None
    with open(path, encoding="utf-8") as fh:
        return {line.strip() for line in fh if line.strip()}


def load_stems(path="/usr/share/hunspell/ru_RU.dic"):
    """Bare dictionary stems, for the fragment rule (постр-процессоров -> постр)."""
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            stems = sorted({ln.split("/")[0].strip().lower() for ln in fh if ln.strip()})
        return stems
    except OSError:
        return []


def is_fragment(seg, stems):
    if len(seg) < 4 or not stems:
        return False
    import bisect
    i = bisect.bisect_left(stems, seg)
    for j in (i, i - 1):
        if 0 <= j < len(stems) and stems[j].startswith(seg):
            return True
    return False


def repo_root(start):
    """Nearest directory with a .git entry (worktrees have a .git file), or None outside a repo."""
    cur = os.path.abspath(start)
    while True:
        if os.path.exists(os.path.join(cur, ".git")):
            return cur
        parent = os.path.dirname(cur)
        if parent == cur:
            return None
        cur = parent


def repo_allow_files(paths, name=REPO_ALLOW_NAME):
    """Project word lists: `.ru-spellcheck-allow` (or `deny`, by `name`) up to each file's git root.

    Walks up rather than taking only the root: a checked file may live in a nested checkout, and
    silently ignoring its dictionary would look like a spelling error in the file's own jargon.
    The deny file is looked up exactly the same way, so both lists follow the checked files.
    """
    found = []
    for path in paths:
        # `-` — stdin: the project dictionary is the one of the current directory.
        start = os.getcwd() if path in ("-", "<stdin>") else os.path.dirname(os.path.abspath(path))
        root = repo_root(start or os.getcwd())
        if root is None:
            continue
        cur = os.path.abspath(start or os.getcwd())
        while True:
            candidate = os.path.join(cur, name)
            if os.path.isfile(candidate) and candidate not in found:
                found.append(candidate)
            if cur == root:
                break
            parent = os.path.dirname(cur)
            if parent == cur:
                break
            cur = parent
    return found


def read_allow_file(path):
    """Allowlist entries are stem-expanded, so `скилл` covers скиллов/скиллу/скиллах."""
    out = set()
    if not path or not os.path.exists(path):
        return out
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            w = line.strip().lower()
            if w and not w.startswith("#"):
                out.add(w)
                out.update(stem(w))
    return out


def load_allow(extra_files=()):
    """Personal allowlist plus the project allowlists found next to the checked files."""
    out = read_allow_file(ALLOW)
    for path in extra_files:
        out |= read_allow_file(path)
    return out


def read_deny_file(path):
    """Denylist entries are exact word forms, deliberately without stem expansion.

    `сет` is banned jargon, `сети` is an ordinary Russian word: stem matching would ban the
    second with the first, and a false positive here means the gate cries on correct prose.
    An entry written as `слово*` opts into stem matching for that entry only — the plural of a
    banned word then reports DENY instead of leaking into SPELLING with a false suggestion
    (#15836 п.3). Stem matching reuses `stem()`, which yields prefixes of four letters or more:
    `слово*` covers `слова`/`слове`, while a short entry such as `сет*` stays effectively exact —
    keep short words without the star.
    """

    out = set()
    if not path or not os.path.exists(path):
        return out
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            w = line.strip().lower()
            if w and not w.startswith("#"):
                out.add(w)
    return out


def load_deny(extra_files=()):
    """Personal denylist plus the project denylists found next to the checked files."""
    out = read_deny_file(DENY)
    for path in extra_files:
        out |= read_deny_file(path)
    return out


def is_denied(word, deny):
    """Exact form always; entries ending with `*` also cover the forms of that word.

    The stem is the same crude one the allow list uses (`скиллу`/`скиллов` -> `скилл`), so
    `ассерт*` catches `ассерты` but not `ассертивность`: prefix matching would have banned the
    latter, and a false positive here means the gate cries on correct prose.
    """
    low = word.lower().strip(".,;:!?«»()\"'")
    if not low:
        return False
    forms = {low, low.replace("ё", "е")}
    if deny & forms:
        return True
    bases = {e[:-1].replace("ё", "е") for e in deny if e.endswith("*") and len(e) > 1}
    return any(s.replace("ё", "е") in bases for form in forms for s in stem(form)) if bases else False


def _blank(match):
    return re.sub(r"[^\n]", " ", match.group(0))


def mask(text):
    for pat in MASK_PATTERNS:
        text = pat.sub(_blank, text)
    return text


# Окончания, которые словарь иногда знает не для всех основ: творительный «маржой», дательный
# «марже». Список узкий намеренно: `-ы`/`-и` здесь нет, потому что именно ими отличается класс
# редукции гласных (`деньгы`, `сесии`), ради которого проверка и существует (#15877 п.4).
FORM_ENDINGS = ("ыми", "ими", "ого", "его", "ому", "ему", "ою", "ею", "ой", "ей", "ам", "ям",
                "ах", "ях", "ом", "ем", "ов", "ев", "ью", "а", "я", "о", "е", "у", "ю", "ь")

# Чем может кончаться словарная основа: существительное или прилагательное в именительном.
BASE_TAILS = ("а", "я", "о", "е", "ь", "ый", "ая", "ое")


def has_dictionary_base(d, low):
    """Словоформа со словарной основой: `маржой` -> `маржа`.

    enchant знает «маржа», но не творительный «маржой» (в словаре флаг без падежных форм), и верное
    слово уходило в SPELLING с подсказкой «баржой». Стем-сверка по уже стоящим в allow словам этого
    не лечила: `--add` на пробел словаря правилами запрещён (#15860 п.8, #15877 п.4).
    """
    for ending in FORM_ENDINGS:
        if not low.endswith(ending):
            continue
        base = low[: -len(ending)]
        if len(base) < 4:
            continue
        if d.check(base):
            # Основа сама по себе есть в словаре — значит это опечатка «слово + гласная»: `документо`,
            # `сервисо`, `системо`, а не падеж слова с другой основой. Замер ревью: все девять
            # таких слов проходили именно здесь, а у цели правки (`марж`) основы в словаре нет.
            continue
        if any(d.check(base + tail) for tail in BASE_TAILS):
            return True
    return False


def is_known(d, word, allow):
    low = word.lower().strip(".,;:!?«»()\"'")
    if not low or low in allow:
        return True
    if any(v in allow for v in stem(low)):
        return True
    variants = {low, low.replace("ё", "е"), low.replace("е", "ё")}
    caps = {v.capitalize() for v in variants} | variants
    if any(d.check(v) for v in caps):
        return True
    return has_dictionary_base(d, low)


def segments(tok):
    return [s for s in re.split(r"[-‑–]", tok) if s]


def check_text(text, d, allow, path, homoglyph_only, baseline=None, stems=None, deny=None):
    findings = []
    hidden = mask(text)
    line_starts = [0]
    for m in re.finditer(r"\n", hidden):
        line_starts.append(m.end())
    for m in TOKEN.finditer(hidden):
        tok = text[m.start():m.end()].strip(EDGE)
        segs = segments(tok)
        # 1. hard error: one segment mixing scripts, or Latin diacritics in a Cyrillic word
        bad_script = any(SCRIPT_MIX.search(s) and CYR.search(s) for s in segs)
        diacritic = bool(DIACRITIC_LATIN.search(tok)) and bool(CYR.search(tok))
        if bad_script or diacritic:
            findings.append((m.start(), "HOMOGLYPH", tok.rstrip("."), ""))
            continue
        if homoglyph_only:
            continue
        # 2. deny, over the segments of any script and before the Cyrillic-only filters below: an
        # entry may be Latin (`tip`), and a token without Cyrillic never reaches the dictionary
        # pass — behind the filters that entry could only ban a word on paper. The filters stay
        # below, so an identifier or an abbreviation is still not dragged into hunspell.
        deny = deny or set()
        denied = set()
        for s in segs:
            if is_denied(s, deny):
                # Приоритет над allow, словарём и baseline: слово не вернуть, его только заменить.
                findings.append((m.start(), "DENY", s.rstrip("."), "слово из deny-списка"))
                denied.add(s)
        if not CYR.search(tok):
            continue  # pure-Latin token: the dictionary has nothing to say about it
        if tok.isupper() and len(tok) <= 5 and not LAT.search(tok):
            continue  # БД, ВР, ОР: abbreviation, not prose
        if len(CYR.findall(tok)) < 3 or ABBREV.fullmatch(tok):
            continue  # "п.1", "т.е.", "п.п.", single letters: not prose
        # 3. dictionary miss, per segment (so "golden-фикстуры" is judged on "фикстуры")
        for s in segs:
            if not CYR.search(s) or LAT.search(s):
                continue  # pure-Latin segment of a compound: not our business
            if s in denied:
                continue  # already reported as DENY above
            if is_known(d, s, allow):
                continue
            if len(segs) > 1 and is_fragment(s, stems or []):
                continue  # left half of a hyphenated compound: постр-процессоров
            if baseline is not None and any(v in baseline for v in stem(s)):
                continue  # jargon/anglicism already used in this project: not a spelling error
            sugg = d.suggest(s.strip(".,;:!?«»*_"))[:3]
            findings.append((m.start(), "SPELLING", s.rstrip("."), ", ".join(sugg)))
    out = []
    for pos, kind, word, sugg in findings:
        line = max(i for i, st in enumerate(line_starts) if st <= pos) + 1
        col = pos - line_starts[line - 1] + 1
        out.append({"file": path, "line": line, "col": col, "kind": kind,
                    "word": word, "suggest": sugg})
    return out


def added_only_text(path, base):
    """Строки файла, добавленные относительно `base`, с сохранением файловой нумерации.

    Остальные строки заменяются пустыми, поэтому отчёт называет ту же строку, что редактор, а
    находки в чужом тексте не появляются (#37: правка шести строк в файле на 233 строки требовала
    либо полного прогона по чужому долгу, либо клея из `git diff -U0 | grep '^+'`).
    """
    import subprocess

    top = subprocess.run(
        ["git", "-C", os.path.dirname(os.path.abspath(path)) or ".", "rev-parse", "--show-toplevel"],
        capture_output=True, text=True,
    )
    if top.returncode != 0:
        raise RuntimeError(f"{path}: не git-репозиторий, --added не применим")
    root = top.stdout.strip()
    rel = os.path.relpath(os.path.abspath(path), root)
    diff = subprocess.run(
        ["git", "-C", root, "diff", "-U0", base, "--", rel],
        capture_output=True, text=True,
    )
    if diff.returncode != 0:
        raise RuntimeError(f"{path}: git diff {base} не вышел: {diff.stderr.strip()}")
    with open(path, encoding="utf-8", errors="replace") as fh:
        lines = fh.read().splitlines()
    added = {}
    number = 0
    for line in diff.stdout.splitlines():
        if line.startswith("@@"):
            # @@ -a,b +c,d @@ — счёт добавленных начинается с c (d может быть 0)
            plus = line.split("+", 1)[1].split(" ", 1)[0]
            start = plus.split(",")[0]
            number = int(start)
            continue
        if line.startswith("+") and not line.startswith("+++"):
            added[number] = line[1:]
            number += 1
        elif line.startswith(" "):
            number += 1
    return "\n".join(added.get(i + 1, "") for i in range(len(lines)))


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "--build-baseline":
        paths = [a for a in argv[1:] if not a.startswith("--")]
        words = set()
        for p in paths:
            with open(p, encoding="utf-8", errors="replace") as fh:
                for w in WORD.findall(fh.read()):
                    words.add(w.lower())
        os.makedirs(os.path.dirname(BASELINE), exist_ok=True)
        with open(BASELINE, "w", encoding="utf-8") as fh:
            fh.write("\n".join(sorted(words)) + "\n")
        print(f"baseline: {len(words)} forms -> {BASELINE}")
        return 0
    if argv[0] in ("--add", "--add-personal"):
        if len(argv) < 2:
            return 2
        # Project jargon belongs to the project: inside a repository `--add` writes the file that is
        # committed with the code, so the next agent does not re-learn the same words (#15717 п.4).
        # Проектный `.ru-spellcheck-deny` тоже участвует: раз проверка его читает, `--add` его
        # не обходит (#15836 п.3).
        denied = load_deny(repo_allow_files([os.path.join(os.getcwd(), "-")], REPO_DENY_NAME))
        blocked = [w for w in argv[1:] if is_denied(w, denied)]
        if blocked:
            print(
                f"ru-spellcheck: отказ — слова в deny-списке: {' '.join(blocked)}",
                file=sys.stderr,
            )
            print(
                f"ru-spellcheck: {DENY} — владение человека: агент не узаконивает собственную лексику;"
                " замените слово в тексте, а не словарь",
                file=sys.stderr,
            )
            return 2
        target = ALLOW
        if argv[0] == "--add" and repo_root(os.getcwd()) is not None:
            target = os.path.join(repo_root(os.getcwd()), REPO_ALLOW_NAME)
        os.makedirs(os.path.dirname(target) or ".", exist_ok=True)
        with open(target, "a", encoding="utf-8") as fh:
            for w in argv[1:]:
                fh.write(w.lower() + "\n")
        print(f"added: {' '.join(argv[1:])} -> {target}")
        return 0
    as_json = "--json" in argv
    homoglyph_only = "--homoglyph-only" in argv
    allow_long = "--allow-long" in argv
    no_baseline = "--no-baseline" in argv
    baseline_path = None  # opt-in only: a model-output baseline also hides real errors
    for i, a in enumerate(argv):
        if a == "--baseline" and i + 1 < len(argv):
            baseline_path = argv[i + 1]
    # --added BASE: проверять только то, что добавлено относительно BASE. Аргумент за флагом — не
    # путь, поэтому он исключается из путей так же, как значение --baseline.
    added_base = None
    for i, a in enumerate(argv):
        if a == "--added" and i + 1 < len(argv):
            added_base = argv[i + 1]
    skip = {"--json", "--homoglyph-only", "--allow-long", "--no-baseline", "--baseline", "--added"}
    paths = [a for a in argv if not a.startswith("--") and a != baseline_path and a != added_base]
    paths = [a for a in paths if a not in skip]
    if not paths:
        return 2
    inputs = []
    if paths == ["-"]:
        inputs.append(("<stdin>", sys.stdin.read()))
    else:
        for p in paths:
            try:
                if added_base is not None:
                    inputs.append((p, added_only_text(p, added_base)))
                else:
                    with open(p, encoding="utf-8", errors="replace") as fh:
                        inputs.append((p, fh.read()))
            except (OSError, IsADirectoryError) as exc:
                print(f"ru-spellcheck: {p}: {exc}", file=sys.stderr)
                return 2
            except RuntimeError as exc:
                print(f"ru-spellcheck: {exc}", file=sys.stderr)
                return 2
    # Refused, not reported clean: the long-text error class is invisible to this gate.
    if homoglyph_only and not allow_long:
        lines = sum(len(text.splitlines()) for _, text in inputs)
        words = sum(len(TOKEN.findall(text)) for _, text in inputs)
        if lines > MAX_SHORT_LINES or words > MAX_SHORT_WORDS:
            print(
                f"ru-spellcheck: --homoglyph-only видит только латинские гомоглифы, а вход — {lines} строк"
                f" / {words} токенов: редукция гласных так не ловится",
                file=sys.stderr,
            )
            print(
                "ru-spellcheck: длинный текст проверяй полным прогоном — ru-spellcheck ФАЙЛ,"
                " находки разбирать руками; --allow-long — осознанный обход",
                file=sys.stderr,
            )
            return 3
    if homoglyph_only:
        d, allow, stems, deny = None, set(), [], set()  # script-mixing needs no dictionary at all
    else:
        # Project allowlists are looked up from the checked files, so stdin uses the cwd.
        d = load_dict()
        allow = load_allow(repo_allow_files(paths))
        stems = load_stems()
        deny = load_deny(repo_allow_files(paths, REPO_DENY_NAME))
    baseline = load_baseline(baseline_path)  # opt-in: --baseline PATH
    results = []
    for path, text in inputs:
        results += check_text(text, d, allow, path, homoglyph_only, baseline, stems, deny)
    if as_json:
        print(json.dumps(results, ensure_ascii=False, indent=1))
    else:
        for r in results:
            tail = f"  -> {r['suggest']}" if r["suggest"] else ""
            print(f"{r['file']}:{r['line']}:{r['col']}  {r['kind']:9s} {r['word']}{tail}")
        if results:
            kinds = {}
            for r in results:
                kinds[r["kind"]] = kinds.get(r["kind"], 0) + 1
            print("\n" + ", ".join(f"{k}: {v}" for k, v in sorted(kinds.items())))
    return 1 if results else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
